NODE_ENV=development
HOST=localhost
PORT=3333
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/taskflow?retryWrites=true&w=majority
REDIS_URL=rediss://default:pass@host:6379
JWT_ACCESS_SECRET=replace-with-a-random-string-of-32-plus-characters
JWT_REFRESH_SECRET=replace-with-another-random-string-of-32-plus-characters
REFRESH_COOKIE_SECRET=replace-with-another-random-string-of-32-plus-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
LOG_LEVEL=info
CORS_ORIGIN=*
